diff --git a/verilog/rx/iq_sampler_16k_32b.v b/verilog/rx/iq_sampler_16k_32b.v
new file mode 100644
index 000000000..6f2e17c60
--- /dev/null
+++ b/verilog/rx/iq_sampler_16k_32b.v
@@ -0,0 +1,67 @@
+`default_nettype none
+
+// IQ sampler, 16K x 2 x 16-bit, 16 36kb BRAMs
+// same clock-domain isolation / look-ahead behaviour as IQ_SAMPLER_8K_32B,
+// but with a 14-bit address (16384 deep). Used for WF channel 0 of the RX4_WF3_ASYM build.
+
+module IQ_SAMPLER_16K_32B (
+    input  wire wr_clk,
+    input  wire wr_rst,
+    input  wire wr_continuous,		// if true, the wr_clk side doesn't stop capturing when buffer full
+    input  wire wr,
+    input  wire [15:0] wr_i,
+    input  wire [15:0] wr_q,
+
+    input  wire rd_clk,
+    input  wire rd_rst,
+    input  wire rd_sync,			// set rd_addr to (wr_addr + 512), look-ahead to previous buffer contents
+    input  wire rd_i,
+    input  wire rd_q,
+    output wire [15:0] rd_iq
+    );
+
+	// wr_clk side
+    reg [13:0] wr_addr;
+    reg        full;
+    wire	   wr_en = wr_continuous? wr : (wr && ~full);
+
+    always @ (posedge wr_clk)
+        if (wr_rst) {wr_addr, full} <= 0;
+        else
+        if (wr_en) {full, wr_addr} <= wr_addr + 1;
+
+    wire [31:0] wr_diq = { wr_i[15 -:16], wr_q[15 -:16] };
+
+	// rd_clk side
+    reg [13:0] rd_addr;
+	wire [13:0] rd_next = rd_addr + rd_q;
+
+	wire [13:0] sync_wr_addr;
+
+    // continuously sync wr_addr => sync_wr_addr
+	SYNC_REG #(.WIDTH(14)) sync_wr_addr_inst (
+	    .in_strobe(1),      .in_reg(wr_addr),           .in_clk(wr_clk),
+	    .out_strobe(),      .out_reg(sync_wr_addr),     .out_clk(rd_clk)
+	);
+
+    always @ (posedge rd_clk)
+        if (rd_rst)
+            rd_addr <= 0;
+        else
+        if (rd_sync)
+        	rd_addr <= { (sync_wr_addr[13:9] + 5'd1), sync_wr_addr[8:0] };
+        else begin
+            rd_addr <= rd_next;
+		end
+
+	wire [31:0] rd_diq;
+	assign rd_iq = rd_i? rd_diq[31 -:16] : rd_diq[15 -:16];
+
+	ipcore_bram_16k_32b iq_samp (
+		.clka	(wr_clk),			.clkb	(rd_clk),
+		.wea	(wr_en),
+		.addra	(wr_addr),			.addrb	(rd_next),
+		.dina	(wr_diq),			.doutb	(rd_diq)
+	);
+
+endmodule
