+function kiwi_ask_pwd_cb(path, val, first)
+{
+	//console.log('kiwi_ask_pwd_cb: path='+ path +' '+ typeof(val) +' "'+ val +'" first='+ first);
+   ext_valpwd(conn_type, val);
+}
