+			s += '<br>Error determining the latest version -- check log';
+		} else {
+			if (vmaj == pmaj && vmin == pmin)
+				s += '<br>Running most current version';
+			else
+				s += '<br>Available version: v'+ pmaj +'.'+ pmin;
+		}
+		msg_update.innerHTML = s;
+	}
+}
