+				
+				if (o.sh == -1) {
+				   // only show single SNR when transverter frequency offset
+               w3_innerHTML('id-rx-snr', ', SNR ', o.sa, ' dB');
+               w3_innerHTML('id-msg-snr', 'SNR: All ', o.sa, ' dB');
+				} else {
+               w3_innerHTML('id-rx-snr', ', SNR ', o.sa, ':', o.sh, ' dB');
